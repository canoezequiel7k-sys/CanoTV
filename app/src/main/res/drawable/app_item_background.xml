<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#202843" />
            <stroke
                android:width="3dp"
                android:color="#B779FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#1B2430" />
            <stroke
                android:width="2dp"
                android:color="#7CC8FF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141B22" />
            <stroke
                android:width="1dp"
                android:color="#305066" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
